<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ff1744">
  <meta name="description" content="SYSTEM HANS IA — catálogo y calibrador de sensibilidades para Free Fire.">
  <title>SYSTEM HANS IA — Sensis FF</title>

  <style>
    :root{
      --bg:#070707;
      --panel:#101010;
      --panel2:#151515;
      --line:#292929;
      --red:#ff1744;
      --red2:#ff3158;
      --text:#f7f7f7;
      --muted:#9b9b9b;
      --green:#35d07f;
      --yellow:#ffd166;
      --shadow:0 18px 50px rgba(0,0,0,.45);
      --radius:20px;
    }

    *{box-sizing:border-box}

    html{scroll-behavior:smooth}

    body{
      margin:0;
      background:
        radial-gradient(circle at 15% 0%, rgba(255,23,68,.14), transparent 28%),
        radial-gradient(circle at 90% 10%, rgba(255,23,68,.08), transparent 24%),
        var(--bg);
      color:var(--text);
      font-family:Arial,Helvetica,sans-serif;
      min-height:100vh;
    }

    button,input,select{font:inherit}
    button{cursor:pointer}
    a{color:inherit;text-decoration:none}

    header{
      position:sticky;
      top:0;
      z-index:50;
      backdrop-filter:blur(16px);
      background:rgba(7,7,7,.88);
      border-bottom:1px solid rgba(255,255,255,.06);
    }

    .nav{
      max-width:1180px;
      margin:auto;
      min-height:70px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      padding:10px 18px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      font-weight:1000;
      letter-spacing:.5px;
    }

    .brand-icon{
      width:38px;
      height:38px;
      border-radius:12px;
      display:grid;
      place-items:center;
      background:linear-gradient(145deg,var(--red),#8e001f);
      box-shadow:0 8px 28px rgba(255,23,68,.25);
    }

    .brand small{
      display:block;
      color:var(--muted);
      font-size:10px;
      margin-top:2px;
    }

    .nav-actions{
      display:flex;
      gap:8px;
    }

    .icon-btn,
    .primary,
    .ghost,
    .tab{
      border:1px solid var(--line);
      background:var(--panel);
      color:var(--text);
      border-radius:12px;
      padding:10px 13px;
      transition:.2s;
    }

    .icon-btn:hover,
    .ghost:hover,
    .tab:hover{
      border-color:#555;
      transform:translateY(-1px);
    }

    .primary{
      border-color:transparent;
      background:linear-gradient(135deg,var(--red),#d50032);
      font-weight:900;
      box-shadow:0 8px 25px rgba(255,23,68,.18);
    }

    .primary:hover{
      filter:brightness(1.08);
      transform:translateY(-1px);
    }

    main{
      max-width:1180px;
      margin:auto;
      padding:28px 18px 70px;
    }

    .hero{
      display:grid;
      grid-template-columns:1.25fr .75fr;
      gap:18px;
      margin-bottom:22px;
    }

    .hero-card,
    .panel{
      background:linear-gradient(
        145deg,
        rgba(22,22,22,.96),
        rgba(12,12,12,.96)
      );
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }

    .hero-card{
      padding:30px;
      overflow:hidden;
      position:relative;
    }

    .hero-card:after{
      content:"";
      position:absolute;
      width:240px;
      height:240px;
      border-radius:50%;
      right:-100px;
      top:-100px;
      background:rgba(255,23,68,.12);
      filter:blur(8px);
    }

    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:7px;
      color:#ff6b87;
      font-size:12px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:1px;
    }

    h1{
      font-size:clamp(30px,6vw,58px);
      line-height:.95;
      margin:13px 0;
    }

    .hero p{
      color:#bdbdbd;
      max-width:700px;
      line-height:1.55;
      margin:0;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:20px;
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:10px;
      align-content:stretch;
    }

    .stat{
      padding:18px;
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:16px;
      display:flex;
      flex-direction:column;
      justify-content:center;
    }

    .stat strong{
      font-size:25px;
    }

    .stat span{
      font-size:12px;
      color:var(--muted);
      margin-top:4px;
    }

    .toolbar{
      display:grid;
      grid-template-columns:1fr 170px 170px;
      gap:10px;
      margin:20px 0 12px;
    }

    .search,
    .select{
      width:100%;
      padding:13px 14px;
      border-radius:13px;
      border:1px solid var(--line);
      background:#0e0e0e;
      color:var(--text);
      outline:none;
    }

    .search:focus,
    .select:focus{
      border-color:var(--red);
    }

    .tabs{
      display:flex;
      gap:8px;
      overflow:auto;
      padding:3px 0 14px;
    }

    .tab{
      white-space:nowrap;
    }

    .tab.active{
      background:rgba(255,23,68,.13);
      border-color:var(--red);
      color:#ff718d;
    }

    .section-title{
      display:flex;
      justify-content:space-between;
      align-items:end;
      gap:10px;
      margin:28px 0 12px;
    }

    .section-title h2{
      margin:0;
      font-size:22px;
    }

    .section-title span{
      color:var(--muted);
      font-size:12px;
    }

    .cards{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
    }

    .card{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:18px;
      padding:16px;
      transition:.2s;
    }

    .card:hover{
      transform:translateY(-3px);
      border-color:#444;
    }

    .card-top{
      display:flex;
      justify-content:space-between;
      gap:10px;
      align-items:flex-start;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:5px;
      padding:6px 9px;
      border-radius:999px;
      font-size:10px;
      font-weight:900;
      background:#1b1b1b;
      border:1px solid #333;
      color:#ddd;
    }

    .badge.red{
      background:rgba(255,23,68,.1);
      border-color:rgba(255,23,68,.4);
      color:#ff718d;
    }

    .badge.green{
      background:rgba(53,208,127,.08);
      border-color:rgba(53,208,127,.3);
      color:#66e29e;
    }

    .card h3{
      font-size:18px;
      margin:12px 0 5px;
    }

    .meta{
      font-size:12px;
      color:var(--muted);
      line-height:1.5;
    }

    .rating{
      margin-top:12px;
      display:flex;
      justify-content:space-between;
      font-size:12px;
    }

    .stars{
      color:var(--yellow);
      letter-spacing:1px;
    }

    .values{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:7px;
      margin-top:13px;
    }

    .value{
      background:#0b0b0b;
      border:1px solid #252525;
      border-radius:10px;
      padding:9px 7px;
      text-align:center;
    }

    .value b{
      display:block;
      font-size:17px;
    }

    .value span{
      display:block;
      font-size:9px;
      color:#777;
      margin-top:2px;
    }

    .card-actions{
      display:flex;
      gap:8px;
      margin-top:13px;
    }

    .card-actions button{
      flex:1;
    }

    .tiny{
      font-size:11px;
      color:#777;
      margin-top:10px;
    }

    .empty{
      padding:35px;
      text-align:center;
      border:1px dashed #333;
      border-radius:16px;
      color:#888;
      grid-column:1/-1;
    }

    .calibrator{
      margin-top:28px;
      padding:20px;
    }

    .form-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:10px;
    }

    .field label{
      display:block;
      font-size:11px;
      color:#aaa;
      margin:0 0 6px;
    }

    .field.full{
      grid-column:1/-1;
    }

    .range-wrap{
      background:#0d0d0d;
      border:1px solid var(--line);
      border-radius:13px;
      padding:11px 13px;
    }

    input[type=range]{
      width:100%;
      accent-color:var(--red);
    }

    .range-line{
      display:flex;
      justify-content:space-between;
      font-size:11px;
      color:#999;
    }

    .result{
      margin-top:18px;
      padding:18px;
      border-radius:17px;
      background:linear-gradient(145deg,#171717,#0d0d0d);
      border:1px solid rgba(255,23,68,.28);
      display:none;
    }

    .result.show{
      display:block;
    }

    .result-head{
      display:flex;
      justify-content:space-between;
      gap:10px;
      align-items:center;
    }

    .result-grid{
      display:grid;
      grid-template-columns:repeat(6,1fr);
      gap:8px;
      margin-top:13px;
    }

    .result-value{
      text-align:center;
      background:#090909;
      border:1px solid #292929;
      border-radius:11px;
      padding:11px 5px;
    }

    .result-value b{
      font-size:20px;
    }

    .result-value span{
      display:block;
      color:#777;
      font-size:9px;
      margin-top:3px;
    }

    .note{
      color:#888;
      font-size:11px;
      line-height:1.5;
      margin-top:12px;
    }

    .community{
      margin-top:28px;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
    }

    .mini-panel{
      padding:18px;
    }

    .mini-panel h3{
      margin-top:0;
    }

    .list{
      display:grid;
      gap:9px;
    }

    .list-item{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      padding:11px;
      border-radius:12px;
      background:#0d0d0d;
      border:1px solid #242424;
    }

    .list-item small{
      color:#777;
      display:block;
      margin-top:3px;
    }

    .pill{
      font-size:10px;
      color:#ff718d;
      border:1px solid rgba(255,23,68,.35);
      padding:5px 7px;
      border-radius:999px;
      white-space:nowrap;
    }

    footer{
      max-width:1180px;
      margin:auto;
      padding:0 18px 35px;
      color:#666;
      font-size:11px;
      text-align:center;
    }

    .modal{
      position:fixed;
      inset:0;
      z-index:100;
      display:none;
      place-items:center;
      background:rgba(0,0,0,.75);
      padding:18px;
    }

    .modal.open{
      display:grid;
    }

    .modal-box{
      width:min(560px,100%);
      max-height:90vh;
      overflow:auto;
      background:#111;
      border:1px solid #333;
      border-radius:20px;
      padding:20px;
      box-shadow:var(--shadow);
    }

    .modal-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .modal-head h3{
      margin:0;
    }

    .close{
      background:#1b1b1b;
      color:white;
      border:1px solid #333;
      border-radius:10px;
      padding:7px 10px;
    }

    .feedback-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:8px;
      margin-top:14px;
    }

    .feedback-grid button{
      padding:12px;
      border-radius:11px;
      border:1px solid #333;
      background:#0b0b0b;
      color:#eee;
    }

    .feedback-grid button:hover{
      border-color:var(--red);
    }

    .toast{
      position:fixed;
      left:50%;
      bottom:22px;
      z-index:200;
      transform:translate(-50%,20px);
      background:#171717;
      border:1px solid #3a3a3a;
      padding:11px 15px;
      border-radius:12px;
      opacity:0;
      pointer-events:none;
      transition:.25s;
      font-size:12px;
    }

    .toast.show{
      opacity:1;
      transform:translate(-50%,0);
    }

    @media(max-width:900px){
      .hero{
        grid-template-columns:1fr;
      }

      .cards{
        grid-template-columns:repeat(2,1fr);
      }

      .form-grid{
        grid-template-columns:repeat(2,1fr);
      }

      .result-grid{
        grid-template-columns:repeat(3,1fr);
      }

      .toolbar{
        grid-template-columns:1fr 1fr;
      }

      .toolbar .search{
        grid-column:1/-1;
      }
    }

    @media(max-width:600px){
      .nav{
        padding:9px 12px;
      }

      .nav-actions .ghost{
        display:none;
      }

      main{
        padding:20px 12px 55px;
      }

      .hero-card{
        padding:22px;
      }

      .stats{
        grid-template-columns:repeat(2,1fr);
      }

      .cards{
        grid-template-columns:1fr;
      }

      .community{
        grid-template-columns:1fr;
      }

      .form-grid{
        grid-template-columns:1fr;
      }

      .field.full{
        grid-column:auto;
      }

      .result-grid{
        grid-template-columns:repeat(2,1fr);
      }

      .toolbar{
        grid-template-columns:1fr;
      }

      .toolbar .search{
        grid-column:auto;
      }

      .hero-actions{
        display:grid;
        grid-template-columns:1fr;
      }

      .hero-actions button{
        width:100%;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="nav">

    <a class="brand" href="#">
      <div class="brand-icon">⚡</div>

      <div>
        SYSTEM HANS IA
        <small>SENSIS FF • COMMUNITY</small>
      </div>
    </a>

    <div class="nav-actions">
      <button class="ghost" onclick="scrollToId('calibrador')">
        Calibrador
      </button>

      <button class="primary" onclick="openFeedback()">
        Valorar una sensi
      </button>
    </div>

  </div>
</header>


<main>

  <!-- HERO -->

  <section class="hero">

    <div class="hero-card">

      <div class="eyebrow">
        ● Sistema de sensibilidades
      </div>

      <h1>
        Encuentra tu<br>
        <span style="color:#ff1744">SENSI</span>.
      </h1>

      <p>
        Explora configuraciones, busca por teléfono y usa el calibrador
        para adaptar una base a tu pantalla, Hz, RAM, cantidad de dedos
        y estilo de juego.
      </p>

      <div class="hero-actions">

        <button class="primary" onclick="scrollToId('catalogo')">
          🔥 Ver sensis
        </button>

        <button class="ghost" onclick="scrollToId('calibrador')">
          ⚙️ Calibrar la mía
        </button>

      </div>

    </div>


    <div class="stats">

      <div class="stat">
        <strong id="statSensis">12</strong>
        <span>Sensis disponibles</span>
      </div>

      <div class="stat">
        <strong id="statModelos">40+</strong>
        <span>Modelos incluidos</span>
      </div>

      <div class="stat">
        <strong id="statLocales">0</strong>
        <span>Valoraciones en este dispositivo</span>
      </div>

      <div class="stat">
        <strong>0–200</strong>
        <span>Escala configurable</span>
      </div>

    </div>

  </section>


  <!-- CATALOGO -->

  <section id="catalogo">

    <div class="section-title">

      <div>
        <h2>🔥 Catálogo de sensis</h2>

        <span>
          Datos de ejemplo hasta que exista una comunidad/backend real.
        </span>
      </div>

    </div>


    <div class="toolbar">

      <input
        id="search"
        class="search"
        type="search"
        placeholder="🔎 Buscar teléfono, estilo o sensi..."
        oninput="renderCatalog()"
      >

      <select
        id="phoneFilter"
        class="select"
        onchange="renderCatalog()"
      >
        <option value="">
          Todos los teléfonos
        </option>
      </select>

      <select
        id="styleFilter"
        class="select"
        onchange="renderCatalog()"
      >
        <option value="">
          Todos los estilos
        </option>

        <option value="Equilibrado">
          Equilibrado
        </option>

        <option value="Rápido">
          Rápido
        </option>

        <option value="Precisión">
          Precisión
        </option>

        <option value="Suave">
          Suave
        </option>

      </select>

    </div>


    <div class="tabs">

      <button
        class="tab active"
        data-tab="destacadas"
        onclick="setTab('destacadas',this)"
      >
        ⭐ Destacadas
      </button>

      <button
        class="tab"
        data-tab="tendencia"
        onclick="setTab('tendencia',this)"
      >
        📈 Tendencia
      </button>

      <button
        class="tab"
        data-tab="nuevas"
        onclick="setTab('nuevas',this)"
      >
        🆕 Nuevas
      </button>

      <button
        class="tab"
        data-tab="todas"
        onclick="setTab('todas',this)"
      >
        📚 Todas
      </button>

    </div>


    <div id="catalog" class="cards"></div>

  </section>


  <!-- CALIBRADOR -->

  <section id="calibrador" class="panel calibrator">

    <div class="section-title" style="margin-top:0">

      <div>
        <h2>⚙️ Calibrador HANS IA</h2>

        <span>
          Parte de una base y la adapta; no promete resultados garantizados.
        </span>
      </div>

    </div>


    <div class="form-grid">

      <div class="field">

        <label>
          📱 Modelo
        </label>

        <select id="device" class="select"></select>

      </div>


      <div class="field">

        <label>
          📶 Frecuencia
        </label>

        <select id="hz" class="select">

          <option value="60">
            60 Hz
          </option>

          <option value="90">
            90 Hz
          </option>

          <option value="120" selected>
            120 Hz
          </option>

          <option value="144">
            144 Hz
          </option>

          <option value="165">
            165 Hz
          </option>

        </select>

      </div>


      <div class="field">

        <label>
          💾 RAM
        </label>

        <select id="ram" class="select">

          <option value="3">
            3 GB
          </option>

          <option value="4">
            4 GB
          </option>

          <option value="6" selected>
            6 GB
          </option>

          <option value="8">
            8 GB
          </option>

          <option value="12">
            12 GB
          </option>

          <option value="16">
            16 GB
          </option>

        </select>

      </div>


      <div class="field">

        <label>
          ☝️ Dedos
        </label>

        <select id="fingers" class="select">

          <option value="2" selected>
            2 dedos
          </option>

          <option value="3">
            3 dedos
          </option>

          <option value="4">
            4 dedos
          </option>

          <option value="5">
            5 dedos
          </option>

        </select>

      </div>


      <div class="field">

        <label>
          🎮 Estilo
        </label>

        <select id="style" class="select">

          <option value="Equilibrado">
            Equilibrado
          </option>

          <option value="Rápido" selected>
            Rápido
          </option>

          <option value="Precisión">
            Precisión
          </option>

          <option value="Suave">
            Suave
          </option>

        </select>

      </div>


      <div class="field">

        <label>
          🎯 Perfil base
        </label>

        <select id="base" class="select">

          <option value="destacada">
            Sensi destacada
          </option>

          <option value="equilibrada">
            Sensi equilibrada
          </option>

          <option value="rapida">
            Sensi rápida
          </option>

          <option value="precision">
            Sensi precisión
          </option>

        </select>

      </div>


      <div class="field">

        <label>
          🔢 Escala
        </label>

        <select id="scale" class="select">

          <option value="200" selected>
            0–200
          </option>

          <option value="100">
            0–100
          </option>

        </select>

      </div>


      <div class="field">

        <label>
          🖐️ Respuesta táctil
        </label>

        <div class="range-
